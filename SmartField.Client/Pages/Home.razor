@page "/"
@attribute [Authorize]
@layout MobileLayout

<PageTitle>SmartField Time</PageTitle>

<section class="mobile-dashboard">
    <div>
        <p class="eyebrow">SmartField Time</p>
        <h1>Registo no terreno</h1>
        <p class="muted">Área móvel preparada para picagens, pausas e tempos por obra.</p>
    </div>

    <AuthorizeView Roles="@AuthConstants.EmployeeRole">
        <Authorized Context="employeeContext">
            <div class="action-grid" aria-label="Ações de assiduidade">
                <button class="primary-action" type="button">Entrada</button>
                <button class="secondary-action" type="button">Pausa</button>
                <button class="secondary-action" type="button">Retomar</button>
                <button class="danger-action" type="button">Saída</button>
            </div>
        </Authorized>
        <NotAuthorized Context="nonEmployeeContext">
            <div class="empty-state">
                <h2>Perfil backoffice</h2>
                <p>Usa a área Backoffice para validação e gestão.</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</section>
