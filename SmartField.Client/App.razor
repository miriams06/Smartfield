<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MobileLayout)">
                <NotAuthorized Context="authContext">
                    @if (authContext.User.Identity?.IsAuthenticated == true)
                    {
                        <LayoutView Layout="@typeof(MobileLayout)">
                            <PageTitle>Acesso negado</PageTitle>
                            <section class="empty-state">
                                <h1>Acesso negado</h1>
                                <p>O teu perfil não tem permissões para esta área.</p>
                            </section>
                        </LayoutView>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Página não encontrada</PageTitle>
            <LayoutView Layout="@typeof(MobileLayout)">
                <section class="empty-state">
                    <h1>Página não encontrada</h1>
                    <p>O endereço pedido não existe no SmartField.</p>
                </section>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
